{
    "name": "Superstore Corporate Modern",
    "dataColors": [
        "#3B82F6",
        "#10B981",
        "#F59E0B",
        "#6366F1",
        "#EC4899",
        "#8B5CF6",
        "#14B8A6"
    ],
    "background": "#F3F4F6",
    "foreground": "#1F2937",
    "tableAccent": "#3B82F6",
    "visualStyles": {
        "*": {
            "*": {
                "background": [
                    {
                        "show": true,
                        "color": {
                            "solid": {
                                "color": "#FFFFFF"
                            }
                        },
                        "transparency": 0
                    }
                ],
                "border": [
                    {
                        "show": false
                    }
                ],
                "title": [
                    {
                        "show": true,
                        "fontFamily": "Segoe UI Semibold",
                        "fontSize": 14,
                        "fontColor": {
                            "solid": {
                                "color": "#1F2937"
                            }
                        }
                    }
                ],
                "labels": [
                    {
                        "fontFamily": "Segoe UI",
                        "fontSize": 9
                    }
                ]
            }
        },
        "card": {
            "*": {
                "labels": [
                    {
                        "fontFamily": "Segoe UI Semibold",
                        "fontSize": 36,
                        "color": {
                            "solid": {
                                "color": "#1F2937"
                            }
                        }
                    }
                ],
                "categoryLabels": [
                    {
                        "fontFamily": "Segoe UI",
                        "fontSize": 10,
                        "color": {
                            "solid": {
                                "color": "#4B5563"
                            }
                        }
                    }
                ]
            }
        }
    }
}